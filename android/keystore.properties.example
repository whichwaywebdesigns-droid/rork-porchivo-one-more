# Copy to android/keystore.properties (gitignored) and fill in for local release signing.
# The keystore file itself must also stay uncommitted (android/.gitignore covers *.jks / *.keystore).
# Used ONLY when android/keystore.properties exists — otherwise release builds fall back to the debug key.
#
# storeFile is resolved relative to android/ (the Gradle root project).
#
# IMPORTANT: use the upload keystore you generated for the 2026-09 Play upload key reset —
# it becomes Play's expected upload key on 2026-09-09. Keep a safe backup of the .jks file.
storeFile=porchivo-upload.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
