# Porchivo (Expo) — client environment variables
#
# Copy this file to `.env` and fill in real values for local development.
# For EAS builds, set the same vars in the EAS per-environment variable store:
#   eas env:create --environment <development|preview|production> --name <VAR> --visibility sensitive
#
# NEVER commit real secrets. `.env` and `.env.*` are git-ignored; only
# `.env.example` is allowed in version control.

# ---------------------------------------------------------------------------
# Supabase (auth + database + storage)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# New publishable key (preferred). Find it in Supabase dashboard → API → Project API keys.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key — only used as a fallback if the publishable key is unset.
# Safe to leave blank once EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY is configured everywhere.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# RevenueCat (in-app purchases / subscriptions)
# ---------------------------------------------------------------------------
# Public SDK keys from RevenueCat dashboard → Project Settings → API Keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Sandbox/test key used when EXPO_PUBLIC_APP_ENV != "production".
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# ---------------------------------------------------------------------------
# Superwall (paywall presentation)
# ---------------------------------------------------------------------------
# Public API keys from Superwall dashboard → Project → Settings → Keys.
EXPO_PUBLIC_SUPERWALL_IOS_API_KEY=
EXPO_PUBLIC_SUPERWALL_ANDROID_API_KEY=

# ---------------------------------------------------------------------------
# Ship24 (package tracking lookups)
# ---------------------------------------------------------------------------
# API key from Ship24 dashboard. Optional in dev; required for live tracking.
EXPO_PUBLIC_SHIP24_API_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Sentry DSN for crash/error reporting. Leave blank to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Rork toolkit / functions (edge function base URLs)
# ---------------------------------------------------------------------------
# Populated automatically by the Rork build environment — usually no need to set locally.
EXPO_PUBLIC_RORK_FUNCTIONS_URL=
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_RORK_API_BASE_URL=
EXPO_PUBLIC_RORK_APP_KEY=
EXPO_PUBLIC_RORK_AUTH_URL=
EXPO_PUBLIC_RORK_TOOLKIT_SECRET_KEY=
EXPO_PUBLIC_TEAM_ID=
EXPO_PUBLIC_TOOLKIT_URL=

# ---------------------------------------------------------------------------
# App environment — set per EAS build profile, NOT in .env
# ---------------------------------------------------------------------------
# Mirrors the EAS profile name so lib/revenueCat.ts can pick the right key.
# Already hardcoded in eas.json for each profile (development / preview / production).
# EXPO_PUBLIC_APP_ENV=

# ---------------------------------------------------------------------------
# QA login autofill (optional — dev/preview only)
# ---------------------------------------------------------------------------
# When set, the login screen pre-fills these credentials for fast QA taps.
# Leave blank in production builds.
EXPO_PUBLIC_QA_EMAIL=
EXPO_PUBLIC_QA_PASSWORD=

# ---------------------------------------------------------------------------
# PostHog analytics + experiments (client-side token — safe to expose)
# ---------------------------------------------------------------------------
# Project API key from posthog.com → Settings → Project (phc_...).
# The app is a full no-op without it (no network calls).
EXPO_PUBLIC_POSTHOG_API_KEY=
# Optional; defaults to https://us.i.posthog.com (use https://eu.i.posthog.com for EU).
EXPO_PUBLIC_POSTHOG_HOST=
