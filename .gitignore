# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (Expo prebuild output only — the native Android app lives in /android and IS committed; the native iOS app lives in /ios and IS committed)
ios/*.orig.*
expo/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — block ALL env variants (never commit secrets)
.env
.env.*
.env*.local
!.env.example

# Play Store service account (referenced by eas.json) — never commit
google-service-account.json
.env.functions

# typescript
*.tsbuildinfo
.vercel

.rork
rork-eslint.config.js
core
node_modules
.expo